    {
      "parameters": {
        "text": "=Company: {{ $json.Company }}\nJob Role: {{ $json[\"Job Role\"] }}\nWhat they are looking for: {{ $json[\"What are you looking for?\"] }}",
        "attributes": {
          "attributes": [
            {
              "name": "segment",
              "description": "Company segment, exactly one of: \"SMB\", \"Enterprise\" or \"Unknown\". Use \"Unknown\" for students, individuals, or when company info is missing or unclear.",
              "required": true
            },
            {
              "name": "intent",
              "description": "Buying intent, exactly one of: \"Browsing\", \"Evaluating\", \"Ready to buy\" or \"Invalid\". Use \"Invalid\" for spam, gibberish, or clearly fake submissions.",
              "required": true
            },
            {
              "name": "score",
              "type": "number",
              "description": "Lead score from 1 to 10, where 10 means ready to buy now.",
              "required": true
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "You are a B2B lead qualification assistant. Classify the lead and extract the requested fields as JSON. Use only the allowed values for segment and intent. Mark intent as \"Invalid\" when the submission is spam, gibberish, or clearly fake; use segment \"Unknown\" for students, individuals, or missing company info. Score using this rubric: 9-10 = has budget and a timeline within 3 months; 7-8 = actively comparing tools, no confirmed budget; 4-6 = interested but no timeline; 1-3 = just curious, student, or no business need."
        }
      },
